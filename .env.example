# Career Agent configuration. Generated by scripts/generate_env_example.py --write.
# Configure a provider through Settings or copy this file to .env.
# Process environment wins over working-directory .env, then runtime-home .env.
# Commented assignments are optional; fill only the values you need.

WAKU_PROVIDER=anthropic

# Provider credentials and scoped overrides

# anthropic
# ANTHROPIC_API_KEY=

# openai
# OPENAI_API_KEY=

# openrouter
# OPENROUTER_API_KEY=

# gemini
# GEMINI_API_KEY=

# deepseek
# DEEPSEEK_API_KEY=

# minimax
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=

# kimi
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=

# glm
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=

# xai
# XAI_API_KEY=

# opencode_zen
# OPENCODE_ZEN_API_KEY=

# opencode_go
# OPENCODE_GO_API_KEY=

# Career and shared provider/runtime configuration

# Optional global credential override.
# WAKU_API_KEY=

# Optional global endpoint override.
# WAKU_BASE_URL=

# Optional main model override.
# WAKU_MODEL=

# Compatible small-model override used by provider configuration.
# WAKU_SMALL_MODEL=

# Runtime home; default ~/.waku, with legacy local-home discovery.
# WAKU_HOME=

# Shared loop bound; default 10. Career stages cap this at 10.
# WAKU_MAX_ITERATIONS=

# Output token bound; default 8192.
# WAKU_MAX_TOKENS=

# Per-call timeout in seconds; default 120.
# WAKU_LLM_TIMEOUT=

# Optional tracing exporter; JSONL traces always persist.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Career HTTP bind address; default 127.0.0.1.
# WAKU_DASHBOARD_HOST=

# Career HTTP port; default 7777. Overrides PORT.
# WAKU_DASHBOARD_PORT=

# Compatible fallback HTTP port when WAKU_DASHBOARD_PORT is absent.
# PORT=
